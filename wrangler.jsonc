/**
 * Cloudflare Worker config for Apeirron (deployed via @opennextjs/cloudflare).
 *
 * Docs:
 *   - Wrangler config schema: https://developers.cloudflare.com/workers/wrangler/configuration/
 *   - OpenNext Cloudflare: https://opennext.js.org/cloudflare
 *
 * Bindings are injected automatically by OpenNext at deploy time
 * (WORKER_SELF_REFERENCE, IMAGES, ASSETS).
 *
 * To enable caching for prerendered pages (recommended), bind a KV namespace
 * and configure it here + in open-next.config.ts. See:
 *   https://opennext.js.org/cloudflare/caching
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "apeirron",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // NOTE: an explicit `limits.cpu_ms` ceiling (fail-fast observability) was
  // tried here but Cloudflare rejects it on the Free plan (error 100328). Re-add
  //   "limits": { "cpu_ms": 5000 }
  // after upgrading to a paid Workers plan.
  "analytics_engine_datasets": [
    {
      "binding": "READ_EVENTS",
      "dataset": "apeirron_reads"
    }
  ],
  // OpenNext incremental cache: prerendered HTML/RSC is served from this KV
  // namespace so the Worker barely executes per request (see open-next.config.ts).
  // Binding name must be exactly NEXT_INC_CACHE_KV.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "89951d582fac471086fee69867c3b4be"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "apeirron"
    }
  ]
}
